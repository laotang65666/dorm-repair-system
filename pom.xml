<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父工程：锁定 Spring Boot 版本（与参考项目 tlias 一致） -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.dormrepair</groupId>
    <artifactId>dorm-repair-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>dorm-repair-parent</name>
    <description>宿舍报修管理系统 - 父工程（多模块 Maven）</description>

    <!-- 子模块（标准嵌套布局，与参考项目 tlias 的多模块思想一致） -->
    <modules>
        <module>dorm-repair-pojo</module>
        <module>dorm-repair-utils</module>
        <module>dorm-repair-web</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.46</lombok.version>
    </properties>

    <!-- 所有子模块都会继承这两个依赖：
         lombok 提供 @Data 等注解；spring-boot-starter 提供 Spring 核心容器（@Component/@Value 等） -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
    </dependencies>
</project>
